{
  "manifest_version": 1,
  "type": "device",
  "name": "Jellyfin & Emby",
  "description": {
    "en": "Control your Jellyfin and Emby players, see what is playing and react to it in scenes.",
    "fr": "Pilotez vos lecteurs Jellyfin et Emby, suivez les lectures et réagissez-y dans vos scènes."
  },
  "version": "0.2.1",
  "docker_image": "ghcr.io/guim31/gladys-jellyfin:0.2.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-jellyfin/main/cover.jpg",
  "categories": [
    "multimedia"
  ],
  "transports": [
    "local"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect to your media server",
        "fr": "Connexion à votre serveur multimédia"
      },
      "description": {
        "en": "Works with Jellyfin (10.9 and later) and Emby. Enter the address of the server (for example http://192.168.1.20:8096) and an API key created for Gladys: on Jellyfin, Dashboard > API Keys; on Emby, Settings > Advanced > API Keys. The integration detects which server it talks to.",
        "fr": "Fonctionne avec Jellyfin (10.9 et suivants) et Emby. Indiquez l'adresse du serveur (par exemple http://192.168.1.20:8096) et une clé d'API créée pour Gladys : sous Jellyfin, Tableau de bord > Clés API ; sous Emby, Paramètres > Avancé > Clés API. L'intégration détecte seule le type de serveur."
      }
    },
    {
      "key": "server_url",
      "type": "string",
      "label": {
        "en": "Server URL",
        "fr": "URL du serveur"
      },
      "description": {
        "en": "Address of the server, port included (8096 by default). An https address behind a reverse proxy works too.",
        "fr": "Adresse du serveur, port inclus (8096 par défaut). Une adresse https derrière un reverse proxy fonctionne aussi."
      },
      "placeholder": {
        "en": "http://192.168.1.20:8096",
        "fr": "http://192.168.1.20:8096"
      },
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API"
      },
      "required": true
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms"
      },
      "description": {
        "en": "Language of the feature names and of the texts. Names are set when a device is created: to rename them after a change, delete and re-add the device.",
        "fr": "Langue des noms de fonctionnalités et des textes. Les noms sont fixés à la création d'un appareil : pour les renommer après un changement, supprimez puis rajoutez l'appareil."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    },
    {
      "key": "library_sensors",
      "type": "boolean",
      "label": {
        "en": "Library sensors",
        "fr": "Capteurs de bibliothèques"
      },
      "description": {
        "en": "Add one item-count sensor per library on the server device (plus episodes for TV shows and tracks for music).",
        "fr": "Ajoute un capteur de nombre d'éléments par bibliothèque sur l'appareil serveur (plus les épisodes pour les séries et les morceaux pour la musique)."
      },
      "required": false,
      "default": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Library refresh interval (s)",
        "fr": "Rafraîchissement des bibliothèques (s)"
      },
      "description": {
        "en": "How often the library counts are refreshed, in seconds. Playback is followed in real time.",
        "fr": "Fréquence de rafraîchissement du nombre d'éléments des bibliothèques, en secondes. Les lectures sont suivies en temps réel."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé"
      },
      "description": {
        "en": "Only for https addresses: accept the self-signed certificate of the server. Leave off for http addresses.",
        "fr": "Uniquement pour les adresses https : accepte le certificat auto-signé du serveur. Laissez désactivé pour les adresses http."
      },
      "required": false,
      "default": false
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 30
    },
    {
      "key": "scan_players",
      "label": {
        "en": "Look for players",
        "fr": "Rechercher les lecteurs"
      },
      "timeout_seconds": 30
    }
  ],
  "widgets": [
    {
      "key": "now_playing",
      "label": {
        "en": "Now playing",
        "fr": "En cours de lecture"
      },
      "description": {
        "en": "Who watches what, and where, with the posters.",
        "fr": "Qui regarde quoi, et où, avec les affiches."
      },
      "icon": "play-circle"
    },
    {
      "key": "player",
      "label": {
        "en": "Player",
        "fr": "Lecteur"
      },
      "description": {
        "en": "The current playback as a remote: artwork, title, remaining time, buttons.",
        "fr": "La lecture en cours en télécommande : jaquette, titre, temps restant, boutons."
      },
      "icon": "tv",
      "settings": [
        {
          "key": "player",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Player",
            "fr": "Lecteur"
          },
          "description": {
            "en": "Leave empty to follow whatever is playing.",
            "fr": "Laissez vide pour suivre ce qui est en cours de lecture."
          },
          "required": false
        }
      ],
      "action_timeout_seconds": 15
    },
    {
      "key": "latest_media",
      "label": {
        "en": "Latest additions",
        "fr": "Derniers ajouts"
      },
      "description": {
        "en": "Posters of the movies, series or albums added lately.",
        "fr": "Affiches des films, séries ou albums ajoutés récemment."
      },
      "icon": "film",
      "settings": [
        {
          "key": "kind",
          "type": "select",
          "label": {
            "en": "Show",
            "fr": "Afficher"
          },
          "required": false,
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": {
                "en": "Movies and series",
                "fr": "Films et séries"
              }
            },
            {
              "value": "movies",
              "label": {
                "en": "Movies",
                "fr": "Films"
              }
            },
            {
              "value": "series",
              "label": {
                "en": "Series",
                "fr": "Séries"
              }
            },
            {
              "value": "music",
              "label": {
                "en": "Albums",
                "fr": "Albums"
              }
            }
          ]
        }
      ]
    }
